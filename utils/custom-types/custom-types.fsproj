<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>custom_types</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    
    <Compile Include="MyTask.fs" />
    <Compile Include="MyAsync.fs" />
    <Compile Include="MyResult.fs" />
    <Compile Include="MyState.fs" />
    <Compile Include="MyReader.fs" />
    <Compile Include="AsyncResult.fs" />
    <Compile Include="TaskResult.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.0.101" />
  </ItemGroup>

</Project>
