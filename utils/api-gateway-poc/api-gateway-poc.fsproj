<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>api_gateway_poc</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Http.fs" />
    <Compile Include="GitHub.fs" />
    <Compile Include="ObservableExtensions.fs" />
    <Compile Include="Profile.fs" />
    <Compile Include="ApiGateway.fs" />
    <Compile Include="Program.fs" />
    <Content Include="user.json" />
    <Content Include="repos.json" />
    <Content Include="App.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Control.Reactive" Version="6.1.2" />
    <PackageReference Include="FSharp.Data" Version="6.6.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Suave" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.0.101" />
  </ItemGroup>

</Project>
