<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>catalog_service_infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="App.config" />
    <None Include="SqlServer\create-event-database.sql" />
    <None Include="SqlServer\create-catalog-database.sql" />
    <Compile Include="SqlServer\Dapper.fs" />
    <Compile Include="SqlServer\EventsDB.fs" />
    <Compile Include="SqlServer\CatalogTypeDB.fs" />
    <Compile Include="SqlServer\CatalogBrandDB.fs" />
    <Compile Include="SqlServer\CatalogDB.fs" />
    <Compile Include="OptionConverter.fs" />
    <Compile Include="CatalogItemCommandHanlder.fs" />
    <Compile Include="CatalogTypeCommandHandler.fs" />
    <Compile Include="CatalogBrandCommandHandler.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BagnoDB" Version="0.0.11" />
    <PackageReference Include="BagnoDB.Serializator" Version="0.0.11" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Dapper.FSharp" Version="4.9.0" />
    <PackageReference Include="FSharpPlus" Version="1.8.0" />
    <PackageReference Include="MongoDB.Driver" Version="3.5.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="SqlHydra.Query" Version="3.0.1" />
    <PackageReference Include="System.Data.SqlClient" Version="4.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\utils\custom-types\custom-types.fsproj" />
    <ProjectReference Include="..\core\catalog-service-core.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.0.101" />
  </ItemGroup>

</Project>
